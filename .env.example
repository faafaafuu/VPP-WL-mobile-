# --- Core ---
VPN_ROUTER_REPOSITORY=sqlite
VPN_ROUTER_SQLITE_PATH=data/vpn-router.db
# Secrets — setup.sh generates these automatically; never commit real values
VPN_ROUTER_TOKEN_SECRET=replace-with-random-32-byte-secret
VPN_ROUTER_ADMIN_TOKEN=replace-with-random-admin-token
# VPN_ROUTER_HOST is set to 0.0.0.0 by docker-compose.yml (nginx handles public access)
VPN_ROUTER_PORT=8080
VPN_ROUTER_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:19006
VPN_ROUTER_ALLOWED_PRODUCT_IDS=vpn.monthly
VPN_ROUTER_PRODUCT_PRICES_RUB=vpn.monthly:200.00,vpn.1m:200.00,vpn.3m:500.00,vpn.6m:900.00
# Tariff format: id:title:days:price_rub[:badge[:max_devices]]
VPN_ROUTER_TARIFFS=vpn.1m:1 месяц:30:200.00::3,vpn.3m:3 месяца:90:500.00:выгоднее:3,vpn.6m:6 месяцев:180:900.00:лучший выбор:3
# Set by setup.sh to http://SERVER_IP or https://DOMAIN
PUBLIC_BASE_URL=http://SERVER_IP
CHECKOUT_MODE=mock
# CHECKOUT_MODE=crypto_manual  # enable crypto payments (multi-coin with live rates)
# Wallet addresses per network (at least one required for crypto_manual)
# CRYPTO_WALLET_TRC20=T...   # USDT/USDC on Tron TRC20
# CRYPTO_WALLET_TON=UQ...    # TON Blockchain
# CRYPTO_WALLET_ETH=0x...    # ETH / USDT BEP20
# CRYPTO_WALLET_BTC=bc1...   # Bitcoin
# Legacy single-wallet shortcut (sets TRC20 wallet)
# CRYPTO_USDT_TRC20_ADDRESS=TXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Exchange rate source: coingecko (live) or fixed (uses CRYPTO_USDT_RATE_RUB)
CRYPTO_RATE_PROVIDER=coingecko
# CRYPTO_USDT_RATE_RUB=90.00  # only used when CRYPTO_RATE_PROVIDER=fixed
# Show a developer testnet option (Sepolia ETH, fixed 0.001) on the invoice page
CRYPTO_ENABLE_TESTNET=false
VPN_ROUTER_RATE_LIMIT_PER_MINUTE=120
VPN_ROUTER_AUDIT_RETENTION_DAYS=30
VPN_ROUTER_HSTS_ENABLED=false
# --- YooKassa (optional, only for CHECKOUT_MODE=yookassa) ---
# VPN_ROUTER_YOOKASSA_SHOP_ID=your-shop-id
# VPN_ROUTER_YOOKASSA_SECRET_KEY=your-secret-key
# VPN_ROUTER_YOOKASSA_RETURN_URL=https://your.domain/payments/return

# --- VLESS Reality nodes (up to 10 supported, VPN_NODE_1..10) ---
# If none set, demo/seed nodes are used (development only).
# Never commit real UUIDs, keys, or IPs. Use a secrets manager or server env.
#
# VPN_NODE_1_HOST=1.2.3.4
# VPN_NODE_1_PORT=443
# VPN_NODE_1_UUID=replace-with-xray-uuid
# VPN_NODE_1_PUBLIC_KEY=replace-with-reality-public-key
# VPN_NODE_1_SHORT_ID=replace-with-short-id
# VPN_NODE_1_SNI=www.microsoft.com
# VPN_NODE_1_FLOW=xtls-rprx-vision
# VPN_NODE_1_FINGERPRINT=chrome
# VPN_NODE_1_LABEL=Node 1 (NL)
# VPN_NODE_1_REGION=eu-west
# VPN_NODE_1_COUNTRY_CODE=NL
# VPN_NODE_1_PRIORITY=10
# VPN_NODE_1_ENABLED=true
#
# VPN_NODE_2_HOST=5.6.7.8
# VPN_NODE_2_PORT=443
# VPN_NODE_2_UUID=replace-with-xray-uuid
# VPN_NODE_2_PUBLIC_KEY=replace-with-reality-public-key
# VPN_NODE_2_SHORT_ID=replace-with-short-id
# VPN_NODE_2_SNI=www.microsoft.com
# VPN_NODE_2_LABEL=Node 2 (DE)
# VPN_NODE_2_REGION=eu-central
# VPN_NODE_2_COUNTRY_CODE=DE
# VPN_NODE_2_PRIORITY=20
# VPN_NODE_2_ENABLED=true
#
# (repeat VPN_NODE_3..5 with same pattern)
