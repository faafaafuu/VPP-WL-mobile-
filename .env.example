# --- Core ---
VPN_ROUTER_REPOSITORY=sqlite
VPN_ROUTER_SQLITE_PATH=data/vpn-router.db
# Secrets — setup.sh generates these automatically; never commit real values
VPN_ROUTER_TOKEN_SECRET=replace-with-random-32-byte-secret
VPN_ROUTER_ADMIN_TOKEN=replace-with-random-admin-token
# VPN_ROUTER_HOST is set to 0.0.0.0 by docker-compose.yml (nginx handles public access)
VPN_ROUTER_PORT=8080
VPN_ROUTER_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:19006
VPN_ROUTER_ALLOWED_PRODUCT_IDS=vpn.monthly
VPN_ROUTER_PRODUCT_PRICES_RUB=vpn.monthly:200.00,vpn.1m:200.00,vpn.3m:500.00,vpn.6m:900.00,vpn.12m:1500.00
# Tariff format: id:title:days:price_rub[:badge[:max_devices[:traffic_gb]]] (traffic_gb 0/omitted = unlimited)
VPN_ROUTER_TARIFFS=vpn.1m:1 месяц:30:200.00::3:150,vpn.3m:3 месяца:90:500.00:выгоднее:3:150,vpn.6m:6 месяцев:180:900.00:лучший выбор:3:150,vpn.12m:12 месяцев:365:1500.00:макс. выгода:3:150
# Set by setup.sh to http://SERVER_IP or https://DOMAIN
PUBLIC_BASE_URL=http://SERVER_IP
CHECKOUT_MODE=mock
# CHECKOUT_MODE=crypto_manual  # enable crypto payments (multi-coin with live rates)
# Wallet addresses per network (at least one required for crypto_manual)
# CRYPTO_WALLET_TRC20=T...    # USDT/USDC on Tron TRC20
# CRYPTO_WALLET_ETH=0x...     # ETH mainnet + USDT/USDC on BEP20 (BSC) and ERC20 (Ethereum) — same 0x address covers all three
# CRYPTO_WALLET_POLYGON=0x... # USDT/USDC on Polygon — separate address only if you don't reuse the ETH one
# CRYPTO_WALLET_SOLANA=...    # USDT/USDC on Solana — different address format (base58), always needs its own wallet
# CRYPTO_WALLET_TON=UQ...     # TON Blockchain
# CRYPTO_WALLET_BTC=bc1...    # Bitcoin
# Legacy single-wallet shortcut (sets TRC20 wallet)
# CRYPTO_USDT_TRC20_ADDRESS=TXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Exchange rate source: coingecko (live) or fixed (uses CRYPTO_USDT_RATE_RUB)
CRYPTO_RATE_PROVIDER=coingecko
# CRYPTO_USDT_RATE_RUB=90.00  # only used when CRYPTO_RATE_PROVIDER=fixed
# --- Automatic crypto payment confirmation (payment watcher) ---
# TronGrid API key (optional but recommended, raises rate limits): https://www.trongrid.io/
# CRYPTO_TRONGRID_API_KEY=
# Etherscan v2 API key (required for ETH / USDT BEP20 watching): https://etherscan.io/apis
# CRYPTO_ETHERSCAN_API_KEY=
# Minimum confirmations before a transfer activates a subscription (TronGrid already returns solidified txs)
CRYPTO_MIN_CONFIRMATIONS=1
# Poll interval for the in-server payment watcher; 0 disables the background thread
CRYPTO_WATCH_INTERVAL_SECONDS=60

# --- Telegram bot (optional): order binding, payment notifications, link recovery ---
# Create a bot via @BotFather and paste its token; username is detected automatically
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_BOT_USERNAME=MyVpnBot

# --- Twenty CRM sync (optional): paid orders are pushed as opportunities ---
# TWENTY_API_URL=http://127.0.0.1:3010
# TWENTY_API_KEY=paste-api-key-from-twenty-settings
# Email fallback: link recovery works without SMTP (email match on /recover);
# with SMTP the paid link is also emailed automatically. Gmail: app password, port 465.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com
VPN_ROUTER_RATE_LIMIT_PER_MINUTE=120
VPN_ROUTER_AUDIT_RETENTION_DAYS=30
VPN_ROUTER_HSTS_ENABLED=false
VPN_ROUTER_YOOKASSA_SHOP_ID=replace-with-yookassa-shop-id
VPN_ROUTER_YOOKASSA_SECRET_KEY=replace-with-yookassa-secret-key
VPN_ROUTER_YOOKASSA_RETURN_URL=https://example.com/payments/return

# --- VLESS Reality nodes (up to 10 supported, VPN_NODE_1..10) ---
# If none set, demo/seed nodes are used (development only).
# Never commit real UUIDs, keys, or IPs. Use a secrets manager or server env.
#
# VPN_NODE_1_HOST=1.2.3.4
# VPN_NODE_1_PORT=443
# VPN_NODE_1_UUID=replace-with-xray-uuid
# VPN_NODE_1_PUBLIC_KEY=replace-with-reality-public-key
# VPN_NODE_1_SHORT_ID=replace-with-short-id
# VPN_NODE_1_SNI=www.microsoft.com
# VPN_NODE_1_FLOW=xtls-rprx-vision
# VPN_NODE_1_FINGERPRINT=chrome
# VPN_NODE_1_LABEL=Node 1 (NL)
# VPN_NODE_1_REGION=eu-west
# VPN_NODE_1_COUNTRY_CODE=NL
# VPN_NODE_1_PRIORITY=10
# VPN_NODE_1_ENABLED=true
#
# VPN_NODE_2_HOST=5.6.7.8
# VPN_NODE_2_PORT=443
# VPN_NODE_2_UUID=replace-with-xray-uuid
# VPN_NODE_2_PUBLIC_KEY=replace-with-reality-public-key
# VPN_NODE_2_SHORT_ID=replace-with-short-id
# VPN_NODE_2_SNI=www.microsoft.com
# VPN_NODE_2_LABEL=Node 2 (DE)
# VPN_NODE_2_REGION=eu-central
# VPN_NODE_2_COUNTRY_CODE=DE
# VPN_NODE_2_PRIORITY=20
# VPN_NODE_2_ENABLED=true
#
# (repeat VPN_NODE_3..5 with same pattern)

# Hysteria2 (UDP/QUIC) node in the subscription — bypasses RU TSPU shaping of TCP Reality
# HYSTERIA2_HOST=your.domain
# HYSTERIA2_PORT=36712
# HYSTERIA2_SNI=your.domain
# HYSTERIA2_PASSWORD=strong-password-matching-hysteria/config.yaml

# --- 3x-ui panel integration (optional) ---
# When set, each paid subscription gets its OWN client added to this inbound via
# the 3x-ui panel API at activation time (individually revocable), instead of
# sharing one static uuid across every subscriber on VPN_NODE_*. All four panel
# vars are required together; all four node-template vars are required with them.
# VPN_ROUTER_XUI_BASE_URL=https://panel.example:2053/your-web-base-path
# VPN_ROUTER_XUI_API_TOKEN=replace-with-panel-api-token   # Panel Settings -> API Tokens in 3x-ui
# VPN_ROUTER_XUI_INBOUND_ID=1
# VPN_ROUTER_XUI_VERIFY_TLS=true
#
# Connection template for links built from panel-provisioned clients (matches the
# inbound above; the uuid itself comes from the panel API response per subscriber):
# VPN_ROUTER_XUI_HOST=1.2.3.4
# VPN_ROUTER_XUI_PORT=443
# VPN_ROUTER_XUI_SNI=www.microsoft.com
# VPN_ROUTER_XUI_PUBLIC_KEY=replace-with-reality-public-key
# VPN_ROUTER_XUI_SHORT_ID=replace-with-short-id
# VPN_ROUTER_XUI_FLOW=xtls-rprx-vision
# VPN_ROUTER_XUI_FINGERPRINT=chrome
# VPN_ROUTER_XUI_LABEL=VPN Router
# VPN_ROUTER_XUI_REGION=eu-west
# VPN_ROUTER_XUI_COUNTRY_CODE=NL
